# Target Tomcat Server

## Web Application Server

* Apache Tomcat Web Application Server.
* Used as the target server for deploying Java `.war` artifacts.
* Jenkins can use the Publish Over SSH plugin to transfer artifacts to the target server.

### Environment Architecture

```text
Jenkins_Master
      |
      ↓
Jenkins_Slave
      |
      | Build
      ↓
*.war
      |
      ↓
QA Tomcat Server
      |
      ↓
QA Testing
      |
      ↓
UAT Tomcat Server
      |
      ↓
UAT Testing
      |
      ↓
Production Tomcat Server(s)
```

## Test Server

```text
Test_Server (VM)

Tools:
- JDK
- Tomcat WAS

Tomcat Port:
8080
```

---

# Deployment

Deployment means copying application artifacts from one server to another.

```text
Source Server                         Target Server

Jenkins_Slave                         Tomcat_Server
     |                                     |
     | target/*.war                        |
     +------------------------------------>|
                                           |
                                           ↓
                                  /opt/tomcat/webapps
```

Example:

```text
Source:
target/*.war

Target:
 /opt/tomcat/webapps/
```

## Jenkins Deployment Pipeline

```groovy
pipeline {
    agent { label 'slave1' }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-17-openjdk-amd64'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('SCM_Checkout') {
            steps {
                git 'https://github.com/PL-DevOps-Cloud-2705/java-webapp-project.git'
            }
        }

        stage('Application Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy to QA Server') {
            steps {
                script {
                    sshPublisher(
                        publishers: [
                            sshPublisherDesc(
                                configName: 'Tomcat_Server_QA',
                                transfers: [
                                    sshTransfer(
                                        cleanRemote: false,
                                        excludes: '',
                                        execCommand: '',
                                        execTimeout: 120000,
                                        flatten: false,
                                        makeEmptyDirs: false,
                                        noDefaultExcludes: false,
                                        patternSeparator: '[, ]+',
                                        remoteDirectory: '.',
                                        remoteDirectorySDF: false,
                                        removePrefix: 'target/',
                                        sourceFiles: 'target/*.war'
                                    )
                                ],
                                usePromotionTimestamp: false,
                                useWorkspaceInPromotion: false,
                                verbose: false
                            )
                        ]
                    )
                }
            }
        }

        stage('Perform QA Testing') {
            steps {
                echo 'Perform QA Testing'
            }
        }

        stage('Deploy to UAT Server') {
            steps {
                script {
                    sshPublisher(
                        publishers: [
                            sshPublisherDesc(
                                configName: 'Tomcat_Server_UAT',
                                transfers: [
                                    sshTransfer(
                                        cleanRemote: false,
                                        excludes: '',
                                        execCommand: '',
                                        execTimeout: 120000,
                                        flatten: false,
                                        makeEmptyDirs: false,
                                        noDefaultExcludes: false,
                                        patternSeparator: '[, ]+',
                                        remoteDirectory: '.',
                                        remoteDirectorySDF: false,
                                        removePrefix: 'target/',
                                        sourceFiles: 'target/*.war'
                                    )
                                ],
                                usePromotionTimestamp: false,
                                useWorkspaceInPromotion: false,
                                verbose: false
                            )
                        ]
                    )
                }
            }
        }

        stage('Perform UAT Testing') {
            steps {
                echo 'Perform UAT Testing'
            }
        }

        stage('Deploy to PROD Server') {
            steps {
                script {
                    sshPublisher(
                        publishers: [
                            sshPublisherDesc(
                                configName: 'Tomcat_Server_PROD',
                                transfers: [
                                    sshTransfer(
                                        cleanRemote: false,
                                        excludes: '',
                                        execCommand: '',
                                        execTimeout: 120000,
                                        flatten: false,
                                        makeEmptyDirs: false,
                                        noDefaultExcludes: false,
                                        patternSeparator: '[, ]+',
                                        remoteDirectory: '.',
                                        remoteDirectorySDF: false,
                                        removePrefix: 'target/',
                                        sourceFiles: 'target/*.war'
                                    )
                                ],
                                usePromotionTimestamp: false,
                                useWorkspaceInPromotion: false,
                                verbose: false
                            )
                        ]
                    )
                }
            }
        }
    }
}
```

